NEXT_PUBLIC_CAL_URL=https://cal.com/your-link
RESEND_API_KEY=re_xxxxxxxxxxxx
# Sender for contact-form notifications. MUST be on a domain verified in Resend.
# Leaving this unset disables email notification rather than falling back to
# Resend's sandbox sender, which only delivers to the account owner and is why
# every enquiry notification was undeliverable.
CONTACT_FROM_EMAIL=hello@aygency.ai
# Where enquiries are sent.
CONTACT_EMAIL=build@aygency.ai

# Durable enquiry capture. Optional: without these the form still works and
# still logs every enquiry, but a lead survives only in the platform log.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CONTACT_ENQUIRY_TABLE=site_enquiries
